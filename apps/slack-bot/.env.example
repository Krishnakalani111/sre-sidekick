# Slack app credentials (Socket Mode) — create at https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...

# The Sidekick backend the bot calls for RCA (POST /investigate)
BACKEND_URL=http://localhost:3000

# Set to 1 to reply with canned data instead of the real backend (offline demo)
USE_MOCK_BACKEND=0
