# Dashboard UI — environment. Copy to .env.local for `npm run dev`.
#
# Base URL of the Sidekick backend, called from the BROWSER. Vite inlines this
# at build time, so a change needs a rebuild (`docker compose up -d --build
# frontend`), not just a container restart.
#
# In Docker the compose file passes this as a build arg; the default below
# matches the backend's published port on the host.
VITE_API_URL=http://localhost:3000
