DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en

# ============================================================
# SRE Sidekick — environment
# Copy to .env and fill in. Everything runs in MOCK mode with
# no keys set, so you can develop the whole pipeline offline.
# ============================================================

# ---- Data source mode ----
# true  = fake-mcp serves canned fixtures (no SigNoz needed)
# false = fake-mcp proxies the REAL local SigNoz (needs SIGNOZ_API_KEY)
USE_FAKE_MCP=true

# ---- SigNoz (local, running via docker) ----
SIGNOZ_BASE_URL=http://localhost:8080
# Create in SigNoz UI -> Settings -> API Keys. Required for LIVE data
# (v3/v4/v5 query_range endpoints return 401 without it).
SIGNOZ_API_KEY=

# ---- MCP ----
# URL the backend's mcp-client connects to. Points at fake-mcp by default;
# swap to the real SigNoz MCP server later.
MCP_SERVER_URL=http://localhost:8000/mcp
FAKE_MCP_PORT=8787

# ---- LLM for RCA (pick whichever is free) ----
# Provider auto-selected: gemini if GEMINI_API_KEY set, else grok if XAI_API_KEY
# set, else a deterministic MOCK client (no key needed).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
XAI_API_KEY=
GROK_MODEL=grok-2-latest

# ---- Backend ----
BACKEND_PORT=3000
INVESTIGATION_MAX_STEPS=4
LOG_LEVEL=info

# From api.slack.com/apps -> your app -> OAuth & Permissions
SLACK_BOT_TOKEN=

# From api.slack.com/apps -> your app -> Basic Information -> App-Level Tokens
SLACK_APP_TOKEN=

# From api.slack.com/apps -> your app -> Basic Information -> Signing Secret
SLACK_SIGNING_SECRET=

# Default channel for outbound notifications (@sre/slack / POST /notify/slack)
SLACK_DEFAULT_CHANNEL=C0BKKKZFBNZ

PORT=3000

# ============================================================
# CRITICAL — everything above has a safe default or runs fine
# empty (mock mode). These are the only ones you must fill in
# yourself for real (non-mock) behavior. Get them from a
# teammate or your own accounts — never commit the filled .env
# or post it anywhere publicly reachable.
#   DEEPGRAM_API_KEY     - console.deepgram.com (voice/STT path)
#   SIGNOZ_API_KEY       - SigNoz UI -> Settings -> API Keys (live data)
#   GEMINI_API_KEY       - aistudio.google.com/apikey (RCA reasoning)
#   XAI_API_KEY          - console.x.ai (alt. RCA provider)
#   SLACK_BOT_TOKEN      - api.slack.com/apps -> OAuth & Permissions
#   SLACK_APP_TOKEN      - api.slack.com/apps -> Basic Information
#   SLACK_SIGNING_SECRET - api.slack.com/apps -> Basic Information
# ============================================================
