{
  "name": "otel-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Two instrumented services (checkout -> payments) emitting traces, logs & metrics to SigNoz.",
  "scripts": {
    "payments": "OTEL_SERVICE_NAME=payments node --import ./tracing.js payments.js",
    "checkout": "OTEL_SERVICE_NAME=checkout node --import ./tracing.js checkout.js",
    "load": "node load.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.205.0",
    "@opentelemetry/auto-instrumentations-node": "^0.68.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.205.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.205.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.205.0",
    "@opentelemetry/sdk-logs": "^0.205.0",
    "@opentelemetry/sdk-metrics": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.205.0",
    "express": "^4.21.2",
    "pino": "^9.5.0"
  }
}
